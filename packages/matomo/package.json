{
  "name": "@kntnt/engagement-metrics-matomo",
  "version": "0.1.0",
  "description": "Matomo Analytics add-on for @kntnt/engagement-metrics.",
  "license": "MIT",
  "author": "Kntnt Sweden AB <info@kntnt.se> (https://www.kntnt.se)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./iife": {
      "default": "./dist/kntnt-engagement-metrics-matomo.min.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target browser --format esm && bun build src/iife.ts --outdir dist --target browser --minify --naming kntnt-engagement-metrics-matomo.min.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "test": "bun test"
  },
  "peerDependencies": {
    "@kntnt/engagement-metrics": ">=0.1.0"
  },
  "keywords": [
    "engagement",
    "metrics",
    "matomo",
    "analytics"
  ]
}
